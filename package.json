{
  "name": "@asqueel/asqueel-js",
  "version": "0.2.0",
  "type": "module",
  "description": "Run Asqueel data models on SQLite in the browser, Node.js and Bun, offline, with Python parity",
  "exports": {
    ".": "./src/index.js",
    "./sqlite": "./src/sqlite.js",
    "./adapters/node": "./src/adapters/node-sqlite.js",
    "./adapters/bun": "./src/adapters/bun-sqlite.js",
    "./adapters/browser": "./src/adapters/browser-sqlite.js",
    "./transfer": "./src/transfer.js"
  },
  "scripts": {
    "export:python": "${PYTHON:-python3} scripts/export_python.py",
    "test": "node --test test/*.test.js",
    "test:bun": "bun test ./test/*.test.js",
    "example": "node examples/render.js",
    "build": "node scripts/build.js",
    "browser": "npm run build && npm run serve",
    "verify:python": "${PYTHON:-python3} scripts/verify_python.py",
    "export:sqlite": "${PYTHON:-python3} scripts/sqlite_oracle.py",
    "export:composition": "${PYTHON:-python3} scripts/composition_oracle.py",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.js",
    "check": "npm test && npm run build",
    "prepack": "npm run check",
    "export:model": "${PYTHON:-python3} scripts/model_oracle.py",
    "update:tools": "npm update --no-save @genrojs/builders @genrojs/bag @genrojs/tytx @genrojs/toolbox @gramlot/gramlot @gramlot/gramlot-serverless",
    "build:file": "node scripts/build_file.js",
    "test:file": "npm run build:file && playwright test --config=playwright.file.config.js",
    "build:assembly": "node scripts/build_file.js --assembly",
    "test:assembly": "npm run build:assembly && playwright test --config=playwright.assembly.config.js",
    "export:assembly": "${PYTHON:-python3} scripts/assembly_oracle.py"
  },
  "dependencies": {
    "@genrojs/bag": ">=0.11.0",
    "@genrojs/builders": ">=0.7.0",
    "@genrojs/toolbox": ">=0.19.0",
    "@genrojs/tytx": ">=0.16.3",
    "@noble/hashes": "2.4.0",
    "wa-sqlite": "1.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@gramlot/gramlot": "0.3.9",
    "@gramlot/gramlot-serverless": "0.2.16",
    "@playwright/test": "1.64.1",
    "codemirror": "6.0.2",
    "esbuild": "^0.25.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asqueel-org/asqueel-js.git"
  },
  "homepage": "https://asqueel-js.readthedocs.io/en/latest/",
  "bugs": {
    "url": "https://github.com/asqueel-org/asqueel-js/issues"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs",
    "ROADMAP.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "python"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "asqueel",
    "sqlite",
    "offline",
    "browser",
    "indexeddb",
    "wasm",
    "orm",
    "data-model",
    "query-builder",
    "migrations"
  ],
  "author": "Softwell S.r.l."
}
