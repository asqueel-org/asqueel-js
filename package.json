{
  "name": "@asqueel/asqueel-js",
  "version": "0.1.1",
  "type": "module",
  "description": "Model-driven SQLite for offline browser applications, Node.js and Bun",
  "exports": {
    ".": "./src/index.js",
    "./sqlite": "./src/sqlite.js",
    "./adapters/node": "./src/adapters/node-sqlite.js",
    "./adapters/bun": "./src/adapters/bun-sqlite.js",
    "./adapters/browser": "./src/adapters/browser-sqlite.js",
    "./transfer": "./src/transfer.js"
  },
  "scripts": {
    "export:python": "${PYTHON:-python3} scripts/export_python.py",
    "test": "node --test test/*.test.js",
    "test:bun": "bun test ./test/*.test.js",
    "example": "node examples/render.js",
    "build": "node scripts/build.js",
    "browser": "npm run build && npm run serve",
    "verify:python": "${PYTHON:-python3} scripts/verify_python.py",
    "export:sqlite": "${PYTHON:-python3} scripts/sqlite_oracle.py",
    "export:composition": "${PYTHON:-python3} scripts/composition_oracle.py",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.js",
    "check": "npm test && npm run build",
    "prepack": "npm run check",
    "export:model": "${PYTHON:-python3} scripts/model_oracle.py",
    "update:tools": "npm update --no-save @genrojs/builders @genrojs/bag @genrojs/tytx @gramlot/gramlot @gramlot/gramlot-serverless"
  },
  "dependencies": {
    "@genrojs/builders": ">=0.7.0",
    "@noble/hashes": "2.4.0",
    "wa-sqlite": "1.0.0",
    "@genrojs/tytx": ">=0.16.3"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@gramlot/gramlot": ">=0.3.8",
    "@gramlot/gramlot-serverless": ">=0.2.15",
    "@playwright/test": "1.64.1",
    "codemirror": "6.0.2",
    "esbuild": "^0.25.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asqueel-org/asqueel-js.git"
  },
  "homepage": "https://github.com/asqueel-org/asqueel-js",
  "bugs": {
    "url": "https://github.com/asqueel-org/asqueel-js/issues"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "docs",
    "ROADMAP.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "python"
  ],
  "publishConfig": {
    "access": "public"
  }
}
