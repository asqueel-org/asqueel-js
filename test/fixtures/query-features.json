    "CREATE TABLE \"app_note\"(\n \"id\" integer NOT NULL,\n \"doc\" integer,\n \"pos\" integer,\n PRIMARY KEY (\"id\"),\n CONSTRAINT \"fk_0a31326f\" FOREIGN KEY (\"doc\", \"pos\") REFERENCES \"app_line\" (\"document_id\", \"pos\") ON UPDATE CASCADE\n)",
