    "CREATE TABLE \"app_item\"(\n \"id\" integer NOT NULL,\n \"company\" text,\n \"stored_value\" integer DEFAULT 5,\n \"stamp\" integer,\n \"computed\" integer GENERATED ALWAYS AS (stored_value * 2) STORED,\n \"draft\" boolean,\n \"deleted\" text,\n PRIMARY KEY (\"id\")\n)",
